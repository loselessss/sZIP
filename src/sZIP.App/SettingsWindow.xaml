<Window x:Class="sZIP.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Text.Settings}" Width="600" Height="510"
        MinWidth="500" MinHeight="460" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Icon="Assets/szip.ico">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="SettingsFields" Margin="0,0,8,0">
                <TextBlock Text="{DynamicResource Text.General}" FontWeight="SemiBold" FontSize="16" />
                <Label Content="{DynamicResource Text.Language}" Target="{Binding ElementName=LanguageComboBox}"
                       Foreground="{DynamicResource TextBrush}" Padding="0" Margin="0,12,0,6" />
                <ComboBox x:Name="LanguageComboBox" MinHeight="36" HorizontalContentAlignment="Stretch"
                          Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}">
                    <ComboBoxItem Tag="system" Content="{DynamicResource Text.SystemLanguage}" />
                    <ComboBoxItem Tag="ko" Content="한국어" />
                    <ComboBoxItem Tag="en" Content="English" />
                </ComboBox>
                <CheckBox x:Name="StartupCheckBox" Content="{DynamicResource Text.StartWithWindows}"
                          Foreground="{DynamicResource TextBrush}" Margin="0,14,0,0" />
                <CheckBox x:Name="ShellIntegrationCheckBox" Content="{DynamicResource Text.ExplorerIntegration}"
                          Foreground="{DynamicResource TextBrush}" Margin="0,12,0,0" />
                <StackPanel x:Name="MsixSettingsPanel" Visibility="Collapsed" Margin="0,16,0,0">
                    <TextBlock Text="{DynamicResource Text.MsixShellManaged}" TextWrapping="Wrap" />
                    <TextBlock Text="{DynamicResource Text.MsixStartupManaged}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <Button Content="{DynamicResource Text.MsixOpenStartupSettings}" Click="OpenStartupSettings_Click"
                            HorizontalAlignment="Left" Margin="0,10,0,0" />
                </StackPanel>
                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,20,0,16" />
                <TextBlock Text="{DynamicResource Text.AutomaticArchiveExtraction}" FontWeight="SemiBold" FontSize="16"
                           TextWrapping="Wrap" />
                <Label Content="{DynamicResource Text.WatchFolder}" Target="{Binding ElementName=WatchFolderTextBox}"
                       Foreground="{DynamicResource TextBrush}" Padding="0" Margin="0,12,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="WatchFolderTextBox" VerticalContentAlignment="Center" />
                    <Button Grid.Column="1" Width="36" Height="36" Padding="0" Margin="8,0,0,0"
                            ToolTip="{DynamicResource Text.BrowseFolder}" AutomationProperties.Name="{DynamicResource Text.BrowseFolder}"
                            Click="BrowseFolder_Click">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" FontSize="16" />
                    </Button>
                </Grid>
                <Label Content="{DynamicResource Text.MaximumArchiveSize}" Target="{Binding ElementName=MaxArchiveMbTextBox}"
                       Foreground="{DynamicResource TextBrush}" Padding="0" Margin="0,12,0,6" />
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="MaxArchiveMbTextBox" Width="110" MaxLength="5" />
                    <TextBlock Text="MB" VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>
                <CheckBox x:Name="DeleteSourceCheckBox" Margin="0,16,0,2" Foreground="{DynamicResource TextBrush}">
                    <TextBlock Text="{DynamicResource Text.DeleteSource}" TextWrapping="Wrap" />
                </CheckBox>
            </StackPanel>
        </ScrollViewer>
        <TextBlock Grid.Row="1" VerticalAlignment="Center" Margin="0,16,190,0" TextWrapping="Wrap">
            <Hyperlink NavigateUri="https://loselessss.github.io/sZIP/" RequestNavigate="PrivacyPolicy_RequestNavigate">
                <Run Text="{DynamicResource Text.PrivacyPolicy}" />
            </Hyperlink>
        </TextBlock>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="{DynamicResource Text.Cancel}" MinWidth="84" IsCancel="True" Margin="0,0,8,0" />
            <Button x:Name="SaveButton" Content="{DynamicResource Text.Save}" MinWidth="84" IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>

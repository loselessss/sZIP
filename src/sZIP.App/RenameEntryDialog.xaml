<Window x:Class="sZIP.App.RenameEntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Text.RenameEntry}" Width="460" SizeToContent="Height"
        MinWidth="380" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Icon="Assets/szip.ico">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{DynamicResource Text.NewName}" FontWeight="SemiBold" />
        <TextBox x:Name="NameTextBox" Grid.Row="1" Margin="0,8,0,0" MinHeight="36"
                 VerticalContentAlignment="Center" MaxLength="255" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{DynamicResource Text.Cancel}" MinWidth="84" IsCancel="True" Margin="0,0,8,0" />
            <Button Content="{DynamicResource Text.Rename}" MinWidth="84" IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}" Click="Rename_Click" />
        </StackPanel>
    </Grid>
</Window>

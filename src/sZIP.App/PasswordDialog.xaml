<Window x:Class="sZIP.App.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="압축 파일 암호" Height="170" Width="420"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Icon="Assets/szip.ico">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="암호화된 압축 파일입니다. 암호를 입력하세요."
                   Margin="0,0,0,12" />
        <PasswordBox x:Name="PasswordInput" Grid.Row="1" Height="28"
                     VerticalContentAlignment="Center" />
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="확인" IsDefault="True" Width="76" Height="28"
                    Click="ConfirmButton_Click" />
            <Button Content="취소" IsCancel="True" Width="76" Height="28"
                    Margin="8,0,0,0" />
        </StackPanel>
    </Grid>
</Window>

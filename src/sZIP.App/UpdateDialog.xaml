<Window x:Class="sZIP.App.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="sZIP Update" Width="640" Height="500" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner" Icon="Assets/szip.ico" ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" />
        <Grid Grid.Row="1" Margin="0,14,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Current Version" />
            <TextBlock x:Name="CurrentVersionText" Grid.Column="1" />
            <TextBlock Grid.Row="1" Text="New Version" />
            <TextBlock x:Name="NewVersionText" Grid.Row="1" Grid.Column="1" />
            <TextBlock Grid.Row="2" Text="Installer" />
            <TextBlock x:Name="InstallerText" Grid.Row="2" Grid.Column="1" />
        </Grid>

        <GroupBox Grid.Row="2" Header="Release Notes">
            <TextBox x:Name="NotesText" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="8" />
        </GroupBox>

        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <ProgressBar x:Name="DownloadProgress" Height="18" Minimum="0" Maximum="100"
                         Visibility="Collapsed" />
            <TextBlock x:Name="StatusText" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="ReleasePageButton" Content="Release Page" MinWidth="100" Margin="0,0,8,0"
                    Click="ReleasePageButton_Click" />
            <Button x:Name="SkipButton" Content="Skip This Version" MinWidth="120" Margin="0,0,8,0"
                    Click="SkipButton_Click" />
            <Button x:Name="LaterButton" Content="Later" MinWidth="80" Margin="0,0,8,0"
                    Click="LaterButton_Click" />
            <Button x:Name="InstallButton" Content="Download and Install" MinWidth="130"
                    Click="InstallButton_Click" />
        </StackPanel>
    </Grid>
</Window>

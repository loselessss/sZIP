<Window x:Class="sZIP.App.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Text.Preview}" Width="940" Height="680" MinWidth="600" MinHeight="430"
        WindowStartupLocation="CenterOwner" Icon="Assets/szip.ico">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock x:Name="FileNameText" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="FileInfoText" Margin="0,5,0,0" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="8">
            <ContentControl x:Name="PreviewContent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Border>
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <ProgressBar x:Name="PreparationProgress" Height="6" IsIndeterminate="True" Margin="0,0,0,10" />
            <DockPanel Grid.Row="1">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                    <Button x:Name="OpenFileButton" Content="{DynamicResource Text.PreviewOpenApp}" Click="OpenFileButton_Click"
                            IsEnabled="False" Margin="0,0,8,0" />
                    <Button Content="{DynamicResource Text.Close}" IsCancel="True" Click="CloseButton_Click" />
                </StackPanel>
                <TextBlock x:Name="PreviewStatusText" Text="{DynamicResource Text.PreviewPreparing}" TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
            </DockPanel>
        </Grid>
    </Grid>
</Window>

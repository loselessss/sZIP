<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Compile Include="..\..\src\sZIP.App\ShellMenuRegistration.cs" Link="Shell\ShellMenuRegistration.cs" />
    <None Include="..\..\packaging\AppxManifest.xml" Link="Shell\AppxManifest.xml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\sZIP.App\app.manifest" Link="Shell\app.manifest" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\sZIP.App\Strings*.resx" Link="Localization\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\sZIP.App\*.xaml" Link="Localization\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\sZIP.Archive\sZIP.Archive.csproj" />
    <ProjectReference Include="..\..\src\sZIP.Application\sZIP.Application.csproj" />
    <ProjectReference Include="..\..\src\sZIP.Domain\sZIP.Domain.csproj" />
    <ProjectReference Include="..\..\src\sZIP.Watcher\sZIP.Watcher.csproj" />
  </ItemGroup>

</Project>
